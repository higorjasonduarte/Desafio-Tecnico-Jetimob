{
  "name": "playwright-imoveis-qa",
  "version": "2.0.0",
  "description": "Automação profissional Playwright - Jetimob",
  "scripts": {
    "test": "npx cross-env NODE_ENV=dev playwright test",
    "test:headless": "npx cross-env NODE_ENV=dev playwright test --headless",
    "test:ui": "npx cross-env NODE_ENV=dev playwright test --ui",
    "report": "npx allure serve allure-results",
    "install:all": "npm install && npx playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "allure-playwright": "^2.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1"
  }
}
